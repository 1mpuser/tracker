# Продакшен-переменные. Скопируйте в .env.prod, заполните и симлинкните:
#   cp .env.prod.example .env.prod
#   ln -s .env.prod .env
# Никогда не коммитьте .env.prod.

# Домен, на котором живёт трекер (A/AAAA запись уже смотрит на IP VPS).
DOMAIN=tracker.example.com

# Почта для Let's Encrypt (уведомления о сертификате).
ACME_EMAIL=you@example.com

# Пароль Postgres. Сгенерируйте: openssl rand -base64 24 | tr -d '/+='
# Никогда не используйте дефолтный «tracker».
POSTGRES_PASSWORD=

# Resend: ключ «Sending access». БЕЗ него production не стартует — регистрация
# и сброс пароля идут только через письма.
RESEND_API_KEY=

# Обратный адрес писем — на домене, который VERIFIED в Resend (обычно mail.домен).
MAIL_FROM=Трекер <noreply@mail.example.com>

# Ключ шифрования секретов интеграций. Сгенерируйте: openssl rand -base64 32
# ВАЖНО: сохраните в менеджер паролей — при потере ключа секреты интеграций
# (токен Telegram-бота, пароль приложения iCloud) не расшифровать, вводить заново.
APP_ENCRYPTION_KEY=

# Кто может регистрироваться: open (любой адрес) | allowlist | closed.
# Уже зарегистрированные пользователи никак не зависят от этого флага.
SIGNUP_MODE=open

# Для SIGNUP_MODE=allowlist — адреса через запятую.
ALLOWED_EMAILS=
