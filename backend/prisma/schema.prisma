generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Category {
  id       Int    @id @default(autoincrement())
  key      String @unique
  label    String
  order    Int    @default(0)
  archived Boolean @default(false)
  statuses DayCategoryStatus[]
}

model Day {
  id             Int      @id @default(autoincrement())
  date           DateTime @unique @db.Date
  youtubeMinutes Int      @default(0)
  pomodoros      Int      @default(0)
  eveningClosed  Boolean  @default(false)
  rating         Int?
  comment        String?
  categories     DayCategoryStatus[]
  dailies        DailyTask[]
  createdAt      DateTime @default(now())
}

model DayCategoryStatus {
  id         Int      @id @default(autoincrement())
  day        Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId      Int
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId Int
  done       Boolean  @default(false)

  @@unique([dayId, categoryId])
}

model DailyTask {
  id              Int       @id @default(autoincrement())
  day             Day       @relation(fields: [dayId], references: [id], onDelete: Cascade)
  dayId           Int
  text            String
  done            Boolean   @default(false)
  order           Int       @default(0)
  carriedFromDate DateTime? @db.Date
  carriedForward  Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model TaskTemplate {
  id    Int    @id @default(autoincrement())
  text  String
  order Int    @default(0)
}

model Settings {
  id                   Int     @id @default(1)
  youtubeBudget        Int     @default(60)
  notificationsEnabled Boolean @default(false)
}

enum GtdStatus {
  inbox
  backlog
  calendar
  someday
  waiting
  project
  reference
  done
  archived
}

model GtdItem {
  id            Int       @id @default(autoincrement())
  title         String
  notes         String?
  status        GtdStatus @default(inbox)
  parentId      Int?
  parent        GtdItem?  @relation("ProjectChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children      GtdItem[] @relation("ProjectChildren")
  scheduledDate DateTime? @db.Date
  scheduledTime String?
  plannedDate   DateTime? @db.Date
  dueDate       DateTime? @db.Date
  priority      Boolean   @default(false)
  waitingFor    String?
  acceptanceCriteria String?
  discussWith        String?
  order         Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  completedAt   DateTime?
}
