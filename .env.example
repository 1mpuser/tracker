DATABASE_URL=postgresql://tracker:tracker@localhost:5434/tracker
DISTRACTION_BUDGET_DEFAULT=60
NEXT_PUBLIC_API_URL=http://localhost:3001
OBSIDIAN_VAULT_DIR=./data/obsidian-export
ICLOUD_APPLE_ID=
ICLOUD_APP_PASSWORD=
ICLOUD_REMINDERS_LIST_NAME=GTD
# Необязательно: бот и чаты настраиваются в интерфейсе (Настройки → «Telegram-бот» и «Чаты»).
# Эти значения — фоллбэк, если в настройках пусто.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SESSION_CALENDAR_NAME=
SESSION_MIN_MINUTES=20
TZ=UTC

# --- Регистрация и вход (многопользовательский режим) ---
# Публичный домен бэкенда — в него вставляются ссылки подтверждения и сброса.
APP_URL=http://localhost:3001
# Способы регистрации: open (любой адрес), allowlist, closed.
SIGNUP_MODE=open
# Для SIGNUP_MODE=allowlist — список адресов через запятую.
ALLOWED_EMAILS=
# Реальные письма шлются через Resend (https://resend.com). Без ключа локально
# письма печатаются в лог бэкенда (кроме production).
RESEND_API_KEY=
MAIL_FROM=Трекер <noreply@example.com>
# «Secure» на cookie сессии. Локально (http://localhost) обязательно false!
COOKIE_SECURE=false
# Разрешённые origins для CORS через запятую (в prod — https://домен).
CORS_ORIGINS=http://localhost:4887,https://tracker.performance:4888
# Ключ шифрования секретов интеграций (32 байта base64): openssl rand -base64 32
APP_ENCRYPTION_KEY=
